"; Keywords — control flow\n"
"[\n"
"  \"else\"\n"
"  \"elif\"\n"
"  \"for\"\n"
"  \"if\"\n"
"  \"match\"\n"
"  \"return\"\n"
"  \"while\"\n"
"  \"yield\"\n"
"  \"switch\"\n"
"  \"case\"\n"
"  \"defer\"\n"
"  \"try\"\n"
"  \"except\"\n"
"  \"finally\"\n"
"  \"raise\"\n"
"] @keyword.control.flow\n"
"\n"
"(break_statement) @keyword.control.flow\n"
"(continue_statement) @keyword.control.flow\n"
"(pass_statement) @keyword.control.flow\n"
"\n"
"; Keywords — declarations\n"
"[\n"
"  \"class\"\n"
"  \"struct\"\n"
"  \"enum\"\n"
"  \"interface\"\n"
"  \"trait\"\n"
"  \"function\"\n"
"  \"property\"\n"
"  \"const\"\n"
"  \"type\"\n"
